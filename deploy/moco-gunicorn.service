[Unit]
Description=Moco Django Gunicorn Service
After=network.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/moco/backend
EnvironmentFile=/home/ec2-user/moco/.env
ExecStart=/home/ec2-user/moco/venv/bin/gunicorn \
  --workers 2 \
  --bind 127.0.0.1:8000 \
  --timeout 120 \
  --graceful-timeout 30 \
  --keep-alive 5 \
  --max-requests 1000 \
  --max-requests-jitter 100 \
  --access-logfile - \
  --error-logfile - \
  --capture-output \
  --log-level info \
  config.wsgi:application
Restart=always
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
